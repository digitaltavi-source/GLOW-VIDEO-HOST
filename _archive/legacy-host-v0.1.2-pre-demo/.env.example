PORT=3000
GLOW_ALLOWED_HOSTS=localhost,127.0.0.1
GLOW_PUBLIC_MCP_URL=http://127.0.0.1:3000/mcp-v2
GLOW_PROTECTED_SERVICE_URL=https://protected-video-factory.example
GLOW_PROTECTED_SERVICE_TOKEN=replace-at-deployment

# Bounded smoke-test only:
GLOW_AUTH_MODE=static_bearer
GLOW_PUBLIC_TEST_BEARER_TOKEN=replace-with-32-plus-character-secret
GLOW_PUBLIC_TEST_SUBJECT=hostinger-video-test-user

# Production-like ChatGPT connected-account path:
# GLOW_AUTH_MODE=oauth
# GLOW_OAUTH_ISSUER=https://<video-project>.supabase.co/auth/v1
# GLOW_OAUTH_AUDIENCE=authenticated
# GLOW_OAUTH_JWKS_URL=https://<video-project>.supabase.co/auth/v1/.well-known/jwks.json
# GLOW_OAUTH_REQUIRED_SCOPES=email
# GLOW_PUBLIC_AUTHORIZATION_SERVER=https://<video-public-host>
# GLOW_SUPABASE_URL=https://<video-project>.supabase.co
# GLOW_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional compatibility mode for operator smoke tests plus OAuth:
# GLOW_AUTH_MODE=hybrid
