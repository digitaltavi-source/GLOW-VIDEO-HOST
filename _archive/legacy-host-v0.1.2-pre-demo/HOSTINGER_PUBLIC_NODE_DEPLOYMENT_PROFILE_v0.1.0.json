{
  "schema_version": "0.1.1",
  "profile_id": "GLOW_VIDEO_HOSTINGER_PUBLIC_MCP",
  "state": "CANDIDATE_NOT_LIVE",
  "purpose": "Deploy the declassified GLOW Video public MCP/auth edge on Hostinger Managed Node.js.",
  "source": {
    "repository": "digitaltavi-source/GLOW-VIDEO-HOST",
    "branch": "candidate/chatgpt-host-v0.1.1"
  },
  "runtime": {
    "node_version": "22.x",
    "repository_root": ".",
    "build_command": "npm install --ignore-scripts && npm run build",
    "start_command": "npm start",
    "health_path": "/healthz",
    "readiness_path": "/readyz",
    "legacy_mcp_path": "/mcp",
    "fresh_chatgpt_mcp_path": "/mcp-v2"
  },
  "required_environment": [
    {
      "name": "GLOW_PROTECTED_SERVICE_URL",
      "secret": false,
      "required": true
    },
    {
      "name": "GLOW_PROTECTED_SERVICE_TOKEN",
      "secret": true,
      "required": true
    },
    {
      "name": "GLOW_PUBLIC_MCP_URL",
      "secret": false,
      "required": true
    },
    {
      "name": "GLOW_ALLOWED_HOSTS",
      "secret": false,
      "required": true
    },
    {
      "name": "GLOW_AUTH_MODE",
      "secret": false,
      "required": true
    },
    {
      "name": "GLOW_OAUTH_ISSUER",
      "secret": false,
      "required_for": "oauth_or_hybrid"
    },
    {
      "name": "GLOW_OAUTH_AUDIENCE",
      "secret": false,
      "required_for": "oauth_or_hybrid"
    },
    {
      "name": "GLOW_OAUTH_JWKS_URL",
      "secret": false,
      "required_for": "oauth_or_hybrid"
    },
    {
      "name": "GLOW_OAUTH_REQUIRED_SCOPES",
      "secret": false,
      "required_for": "oauth_or_hybrid"
    },
    {
      "name": "GLOW_PUBLIC_AUTHORIZATION_SERVER",
      "secret": false,
      "required_for": "oauth_or_hybrid"
    },
    {
      "name": "GLOW_SUPABASE_URL",
      "secret": false,
      "required_for": "consent_ui"
    },
    {
      "name": "GLOW_SUPABASE_PUBLISHABLE_KEY",
      "secret": false,
      "required_for": "consent_ui"
    }
  ],
  "security": {
    "private_assets_embedded": false,
    "private_release_hashes_public": false,
    "model_session_private_is_public_delivery": false,
    "static_bearer_user_facing": false,
    "protected_backend_unavailable": "FAIL_CLOSED"
  },
  "claims": {
    "hostinger_deployed": false,
    "publicly_reachable": false,
    "oauth_live": false,
    "chatgpt_connected": false,
    "field_verified": false
  },
  "next_gate": "PUBLIC_CI_PASS_THEN_PROTECTED_BACKEND_BINDING"
